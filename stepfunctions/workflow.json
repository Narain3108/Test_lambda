{
  "Comment": "Invoke Worker Lambda Demo",
  "StartAt": "InvokeHelloLambda",
  "States": {
    "InvokeHelloLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "hello-worker-lambda",
        "Payload": {
          "source": "stepfunction"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
